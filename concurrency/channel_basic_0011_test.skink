module channel_basic_0011_test

import "channel_basic_0011"
import "testing"

pub fn TestSendRecv() {
    testing.Reset()
    if channel_basic_0011.send_recv(59) != 59 {
        testing.Errorf("send_recv(59) should return 59")
    }
    if channel_basic_0011.send_recv(0) != 0 {
        testing.Errorf("send_recv(0) should return 0")
    }
}

