module spawn_worker_0004_test

import "spawn_worker_0004"
import "testing"

pub fn TestSpawnCompute() {
    testing.Reset()
    if spawn_worker_0004.spawn_compute(42) != 84 {
        testing.Errorf("spawn_compute(42) should return 84")
    }
    if spawn_worker_0004.spawn_compute(0) != 0 {
        testing.Errorf("spawn_compute(0) should return 0")
    }
}

