module channel_basic_0015_test

import "channel_basic_0015"
import "testing"

pub fn TestSendRecv() {
    testing.Reset()
    if channel_basic_0015.send_recv(83) != 83 {
        testing.Errorf("send_recv(83) should return 83")
    }
    if channel_basic_0015.send_recv(0) != 0 {
        testing.Errorf("send_recv(0) should return 0")
    }
}

