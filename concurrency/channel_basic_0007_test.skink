module channel_basic_0007_test

import "channel_basic_0007"
import "testing"

pub fn TestSendRecv() {
    testing.Reset()
    if channel_basic_0007.send_recv(35) != 35 {
        testing.Errorf("send_recv(35) should return 35")
    }
    if channel_basic_0007.send_recv(0) != 0 {
        testing.Errorf("send_recv(0) should return 0")
    }
}

