module channel_basic_0001_test

import "channel_basic_0001"
import "testing"

pub fn TestSendRecv() {
    testing.Reset()
    if channel_basic_0001.send_recv(49) != 49 {
        testing.Errorf("send_recv(49) should return 49")
    }
    if channel_basic_0001.send_recv(0) != 0 {
        testing.Errorf("send_recv(0) should return 0")
    }
}

