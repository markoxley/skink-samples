module spawn_worker_0006_test

import "spawn_worker_0006"
import "testing"

pub fn TestSpawnCompute() {
    testing.Reset()
    if spawn_worker_0006.spawn_compute(4) != 8 {
        testing.Errorf("spawn_compute(4) should return 8")
    }
    if spawn_worker_0006.spawn_compute(0) != 0 {
        testing.Errorf("spawn_compute(0) should return 0")
    }
}

