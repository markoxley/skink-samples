module spawn_worker_0008_test

import "spawn_worker_0008"
import "testing"

pub fn TestSpawnCompute() {
    testing.Reset()
    if spawn_worker_0008.spawn_compute(66) != 132 {
        testing.Errorf("spawn_compute(66) should return 132")
    }
    if spawn_worker_0008.spawn_compute(0) != 0 {
        testing.Errorf("spawn_compute(0) should return 0")
    }
}

