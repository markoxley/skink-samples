module spawn_worker_0003_test

import "spawn_worker_0003"
import "testing"

pub fn TestSpawnCompute() {
    testing.Reset()
    if spawn_worker_0003.spawn_compute(11) != 22 {
        testing.Errorf("spawn_compute(11) should return 22")
    }
    if spawn_worker_0003.spawn_compute(0) != 0 {
        testing.Errorf("spawn_compute(0) should return 0")
    }
}

