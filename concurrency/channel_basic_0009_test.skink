module channel_basic_0009_test

import "channel_basic_0009"
import "testing"

pub fn TestSendRecv() {
    testing.Reset()
    if channel_basic_0009.send_recv(97) != 97 {
        testing.Errorf("send_recv(97) should return 97")
    }
    if channel_basic_0009.send_recv(0) != 0 {
        testing.Errorf("send_recv(0) should return 0")
    }
}

