module channel_basic_0012_test

import "channel_basic_0012"
import "testing"

pub fn TestSendRecv() {
    testing.Reset()
    if channel_basic_0012.send_recv(90) != 90 {
        testing.Errorf("send_recv(90) should return 90")
    }
    if channel_basic_0012.send_recv(0) != 0 {
        testing.Errorf("send_recv(0) should return 0")
    }
}

