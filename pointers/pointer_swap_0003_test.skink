module pointer_swap_0003_test

import "pointer_swap_0003"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0003.double_val(11) != 22 {
        testing.Errorf("double_val(11) should be 22")
    }
    if pointer_swap_0003.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

