module pointer_swap_0005_test

import "pointer_swap_0005"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0005.double_val(73) != 146 {
        testing.Errorf("double_val(73) should be 146")
    }
    if pointer_swap_0005.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

