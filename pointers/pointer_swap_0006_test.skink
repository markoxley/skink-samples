module pointer_swap_0006_test

import "pointer_swap_0006"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0006.double_val(4) != 8 {
        testing.Errorf("double_val(4) should be 8")
    }
    if pointer_swap_0006.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

