module pointer_swap_0008_test

import "pointer_swap_0008"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0008.double_val(66) != 132 {
        testing.Errorf("double_val(66) should be 132")
    }
    if pointer_swap_0008.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

