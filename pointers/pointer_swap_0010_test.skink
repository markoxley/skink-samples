module pointer_swap_0010_test

import "pointer_swap_0010"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0010.double_val(28) != 56 {
        testing.Errorf("double_val(28) should be 56")
    }
    if pointer_swap_0010.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

