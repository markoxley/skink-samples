module pointer_swap_0001_test

import "pointer_swap_0001"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0001.double_val(49) != 98 {
        testing.Errorf("double_val(49) should be 98")
    }
    if pointer_swap_0001.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

