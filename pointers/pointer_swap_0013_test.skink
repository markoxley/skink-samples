module pointer_swap_0013_test

import "pointer_swap_0013"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0013.double_val(21) != 42 {
        testing.Errorf("double_val(21) should be 42")
    }
    if pointer_swap_0013.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

