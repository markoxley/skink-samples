module pointer_swap_0009_test

import "pointer_swap_0009"
import "testing"

pub fn TestDoubleVal() {
    testing.Reset()
    if pointer_swap_0009.double_val(97) != 194 {
        testing.Errorf("double_val(97) should be 194")
    }
    if pointer_swap_0009.double_val(0) != 0 {
        testing.Errorf("double_val(0) should be 0")
    }
}

