module type_mismatch_0004_test

import "type_mismatch_0004"
import "testing"

pub fn TestDouble() {
    testing.Reset()
    if type_mismatch_0004.double(42) != 84 {
        testing.Errorf("double(42) should be 84")
    }
    if type_mismatch_0004.double(0) != 0 {
        testing.Errorf("double(0) should be 0")
    }
}

