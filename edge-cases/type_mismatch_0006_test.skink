module type_mismatch_0006_test

import "type_mismatch_0006"
import "testing"

pub fn TestDouble() {
    testing.Reset()
    if type_mismatch_0006.double(4) != 8 {
        testing.Errorf("double(4) should be 8")
    }
    if type_mismatch_0006.double(0) != 0 {
        testing.Errorf("double(0) should be 0")
    }
}

