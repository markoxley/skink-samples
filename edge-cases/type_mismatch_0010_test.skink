module type_mismatch_0010_test

import "type_mismatch_0010"
import "testing"

pub fn TestDouble() {
    testing.Reset()
    if type_mismatch_0010.double(28) != 56 {
        testing.Errorf("double(28) should be 56")
    }
    if type_mismatch_0010.double(0) != 0 {
        testing.Errorf("double(0) should be 0")
    }
}

