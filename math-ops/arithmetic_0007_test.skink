module arithmetic_0007_test

import "arithmetic_0007"
import "testing"

pub fn TestArith() {
    testing.Reset()
    s, d, p, q := arithmetic_0007.arith(35, 2)
    if s != 37 { testing.Errorf("sum should be 37, got {s}") }
    if d != 33 { testing.Errorf("diff should be 33, got {d}") }
    if p != 70 { testing.Errorf("prod should be 70, got {p}") }
    if q != 17 { testing.Errorf("quot should be 17, got {q}") }
}

pub fn TestPowerOfTwo() {
    testing.Reset()
    if arithmetic_0007.power_of_two(0) != 1 { testing.Errorf("2^0 should be 1") }
    if arithmetic_0007.power_of_two(1) != 2 { testing.Errorf("2^1 should be 2") }
    if arithmetic_0007.power_of_two(5) != 32 { testing.Errorf("2^5 should be 32") }
    if arithmetic_0007.power_of_two(10) != 1024 { testing.Errorf("2^10 should be 1024") }
}

