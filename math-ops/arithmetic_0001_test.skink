module arithmetic_0001_test

import "arithmetic_0001"
import "testing"

pub fn TestArith() {
    testing.Reset()
    s, d, p, q := arithmetic_0001.arith(49, 16)
    if s != 65 { testing.Errorf("sum should be 65, got {s}") }
    if d != 33 { testing.Errorf("diff should be 33, got {d}") }
    if p != 784 { testing.Errorf("prod should be 784, got {p}") }
    if q != 3 { testing.Errorf("quot should be 3, got {q}") }
}

pub fn TestPowerOfTwo() {
    testing.Reset()
    if arithmetic_0001.power_of_two(0) != 1 { testing.Errorf("2^0 should be 1") }
    if arithmetic_0001.power_of_two(1) != 2 { testing.Errorf("2^1 should be 2") }
    if arithmetic_0001.power_of_two(5) != 32 { testing.Errorf("2^5 should be 32") }
    if arithmetic_0001.power_of_two(10) != 1024 { testing.Errorf("2^10 should be 1024") }
}

