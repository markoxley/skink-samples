module arithmetic_0003_test

import "arithmetic_0003"
import "testing"

pub fn TestArith() {
    testing.Reset()
    s, d, p, q := arithmetic_0003.arith(11, 28)
    if s != 39 { testing.Errorf("sum should be 39, got {s}") }
    if d != -17 { testing.Errorf("diff should be -17, got {d}") }
    if p != 308 { testing.Errorf("prod should be 308, got {p}") }
    if q != 0 { testing.Errorf("quot should be 0, got {q}") }
}

pub fn TestPowerOfTwo() {
    testing.Reset()
    if arithmetic_0003.power_of_two(0) != 1 { testing.Errorf("2^0 should be 1") }
    if arithmetic_0003.power_of_two(1) != 2 { testing.Errorf("2^1 should be 2") }
    if arithmetic_0003.power_of_two(5) != 32 { testing.Errorf("2^5 should be 32") }
    if arithmetic_0003.power_of_two(10) != 1024 { testing.Errorf("2^10 should be 1024") }
}

