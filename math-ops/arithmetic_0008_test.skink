module arithmetic_0008_test

import "arithmetic_0008"
import "testing"

pub fn TestArith() {
    testing.Reset()
    s, d, p, q := arithmetic_0008.arith(16, 33)
    if s != 49 { testing.Errorf("sum should be 49, got {s}") }
    if d != -17 { testing.Errorf("diff should be -17, got {d}") }
    if p != 528 { testing.Errorf("prod should be 528, got {p}") }
    if q != 0 { testing.Errorf("quot should be 0, got {q}") }
}

pub fn TestPowerOfTwo() {
    testing.Reset()
    if arithmetic_0008.power_of_two(0) != 1 { testing.Errorf("2^0 should be 1") }
    if arithmetic_0008.power_of_two(1) != 2 { testing.Errorf("2^1 should be 2") }
    if arithmetic_0008.power_of_two(5) != 32 { testing.Errorf("2^5 should be 32") }
    if arithmetic_0008.power_of_two(10) != 1024 { testing.Errorf("2^10 should be 1024") }
}

