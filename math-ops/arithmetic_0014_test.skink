module arithmetic_0014_test

import "arithmetic_0014"
import "testing"

pub fn TestArith() {
    testing.Reset()
    s, d, p, q := arithmetic_0014.arith(2, 19)
    if s != 21 { testing.Errorf("sum should be 21, got {s}") }
    if d != -17 { testing.Errorf("diff should be -17, got {d}") }
    if p != 38 { testing.Errorf("prod should be 38, got {p}") }
    if q != 0 { testing.Errorf("quot should be 0, got {q}") }
}

pub fn TestPowerOfTwo() {
    testing.Reset()
    if arithmetic_0014.power_of_two(0) != 1 { testing.Errorf("2^0 should be 1") }
    if arithmetic_0014.power_of_two(1) != 2 { testing.Errorf("2^1 should be 2") }
    if arithmetic_0014.power_of_two(5) != 32 { testing.Errorf("2^5 should be 32") }
    if arithmetic_0014.power_of_two(10) != 1024 { testing.Errorf("2^10 should be 1024") }
}

