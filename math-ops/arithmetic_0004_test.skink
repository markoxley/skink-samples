module arithmetic_0004_test

import "arithmetic_0004"
import "testing"

pub fn TestArith() {
    testing.Reset()
    s, d, p, q := arithmetic_0004.arith(42, 9)
    if s != 51 { testing.Errorf("sum should be 51, got {s}") }
    if d != 33 { testing.Errorf("diff should be 33, got {d}") }
    if p != 378 { testing.Errorf("prod should be 378, got {p}") }
    if q != 4 { testing.Errorf("quot should be 4, got {q}") }
}

pub fn TestPowerOfTwo() {
    testing.Reset()
    if arithmetic_0004.power_of_two(0) != 1 { testing.Errorf("2^0 should be 1") }
    if arithmetic_0004.power_of_two(1) != 2 { testing.Errorf("2^1 should be 2") }
    if arithmetic_0004.power_of_two(5) != 32 { testing.Errorf("2^5 should be 32") }
    if arithmetic_0004.power_of_two(10) != 1024 { testing.Errorf("2^10 should be 1024") }
}

