module string_concat_0013_test

import "string_concat_0013"
import "testing"

pub fn TestBuildMessage() {
    testing.Reset()
    result := string_concat_0013.build_message("Welcome", "nora", "berlin")
    expected := "Welcome, nora! Welcome from berlin."
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

