module main
import "std/testing"
import "str_module_0007_test"

fn main() -> int {
    passed := true
    testing.Reset()
    str_module_0007_test.TestCountChars()
    if testing.Failed() {
        passed = false
    }
    testing.Reset()
    str_module_0007_test.TestContainsCheck()
    if testing.Failed() {
        passed = false
    }
    testing.Reset()
    str_module_0007_test.TestFindIndex()
    if testing.Failed() {
        passed = false
    }
    if passed { return 0 }
    return 1
}
