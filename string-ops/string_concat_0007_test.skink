module string_concat_0007_test

import "string_concat_0007"
import "testing"

pub fn TestBuildMessage() {
    testing.Reset()
    result := string_concat_0007.build_message("Hola", "henry", "prague")
    expected := "Hola, henry! Welcome from prague."
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

