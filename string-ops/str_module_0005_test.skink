module str_module_0005_test

import "str_module_0005"
import "testing"

pub fn TestCountChars() {
    testing.Reset()
    if str_module_0005.count_chars("hello") != 5 {
        testing.Errorf("len('hello') should be 5")
    }
    if str_module_0005.count_chars("") != 0 {
        testing.Errorf("len('') should be 0")
    }
    if str_module_0005.count_chars("fig") != 3 {
        testing.Errorf("len('fig') should be 3")
    }
}

pub fn TestContainsCheck() {
    testing.Reset()
    if !str_module_0005.contains_check("hello world", "world") {
        testing.Errorf("should contain 'world'")
    }
    if str_module_0005.contains_check("hello", "xyz") {
        testing.Errorf("should not contain 'xyz'")
    }
}

pub fn TestFindIndex() {
    testing.Reset()
    if str_module_0005.find_index("hello", "ll") != 2 {
        testing.Errorf("indexOf('hello','ll') should be 2")
    }
    if str_module_0005.find_index("hello", "xyz") != -1 {
        testing.Errorf("indexOf('hello','xyz') should be -1")
    }
}

