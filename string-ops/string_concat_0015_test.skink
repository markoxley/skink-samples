module string_concat_0015_test

import "string_concat_0015"
import "testing"

pub fn TestBuildMessage() {
    testing.Reset()
    result := string_concat_0015.build_message("Howdy", "paul", "rome")
    expected := "Howdy, paul! Welcome from rome."
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

