module str_module_0004_test

import "str_module_0004"
import "testing"

pub fn TestCountChars() {
    testing.Reset()
    if str_module_0004.count_chars("hello") != 5 {
        testing.Errorf("len('hello') should be 5")
    }
    if str_module_0004.count_chars("") != 0 {
        testing.Errorf("len('') should be 0")
    }
    if str_module_0004.count_chars("elderberry") != 10 {
        testing.Errorf("len('elderberry') should be 10")
    }
}

pub fn TestContainsCheck() {
    testing.Reset()
    if !str_module_0004.contains_check("hello world", "world") {
        testing.Errorf("should contain 'world'")
    }
    if str_module_0004.contains_check("hello", "xyz") {
        testing.Errorf("should not contain 'xyz'")
    }
}

pub fn TestFindIndex() {
    testing.Reset()
    if str_module_0004.find_index("hello", "ll") != 2 {
        testing.Errorf("indexOf('hello','ll') should be 2")
    }
    if str_module_0004.find_index("hello", "xyz") != -1 {
        testing.Errorf("indexOf('hello','xyz') should be -1")
    }
}

