module match_range_0001

// grade returns a letter grade for a score using range patterns.
pub fn grade(score: int) -> string {
    return match score {
        90..101 => "A",
        80..90  => "B",
        70..80  => "C",
        60..70  => "D",
        _       => "F",
    }
}

fn main() -> int {
    g := grade(48)
    print("Grade: {g}")
    return 0
}
