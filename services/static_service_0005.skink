module static_service_0005

// LoggerService defines a logging interface with multiple levels.
service LoggerService {
    fn Info(msg: string)
    fn Warn(msg: string)
    fn Error(msg: string)
    fn Count() -> int
}

// LoggerImpl implements LoggerService, tracking total log count.
pub struct LoggerImpl {
    count: int
}

service LoggerService for LoggerImpl {
    fn Info(self: *LoggerImpl, msg: string) {
        self.count = self.count + 1
    }

    fn Warn(self: *LoggerImpl, msg: string) {
        self.count = self.count + 1
    }

    fn Error(self: *LoggerImpl, msg: string) {
        self.count = self.count + 1
    }

    fn Count(self: LoggerImpl) -> int {
        return self.count
    }
}

pub fn demo() -> int {
    l := LoggerImpl{count: 0}
    l.Info("starting")
    l.Warn("low memory")
    l.Error("disk full")
    return l.Count()
}

fn main() -> int {
    result := demo()
    print("Log count: {result}")
    return 0
}
