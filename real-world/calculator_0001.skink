module calculator_0001

// calc performs a basic arithmetic operation.
// op: "add", "sub", "mul", "div"
pub fn calc(a: float, b: float, op: string) -> float {
    switch op {
    case "add":
        return a + b
    case "sub":
        return a - b
    case "mul":
        return a * b
    case "div":
        if b == 0.0 {
            return 0.0
        }
        return a / b
    default:
        return 0.0
    }
}

fn main() -> int {
    result := calc(5.8, 7.5, "add")
    print("Result: {result}")
    return 0
}
