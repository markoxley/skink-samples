module multi_return_0009_test

import "multi_return_0009"
import "testing"

pub fn TestDivmod() {
    testing.Reset()
    q, r := multi_return_0009.divmod(106, 5)
    if q != 21 {
        testing.Errorf("expected quotient 21, got {q}")
    }
    if r != 1 {
        testing.Errorf("expected remainder 1, got {r}")
    }
}

