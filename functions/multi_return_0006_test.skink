module multi_return_0006_test

import "multi_return_0006"
import "testing"

pub fn TestDivmod() {
    testing.Reset()
    q, r := multi_return_0006.divmod(13, 2)
    if q != 6 {
        testing.Errorf("expected quotient 6, got {q}")
    }
    if r != 1 {
        testing.Errorf("expected remainder 1, got {r}")
    }
}

