module multi_return_0008_test

import "multi_return_0008"
import "testing"

pub fn TestDivmod() {
    testing.Reset()
    q, r := multi_return_0008.divmod(75, 4)
    if q != 18 {
        testing.Errorf("expected quotient 18, got {q}")
    }
    if r != 3 {
        testing.Errorf("expected remainder 3, got {r}")
    }
}

