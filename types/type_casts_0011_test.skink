module type_casts_0011_test

import "type_casts_0011"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0011.cast_demo(35.8, 76)
    if i != 35 {
        testing.Errorf("expected int 35, got {i}")
    }
    if f != 76.0 {
        testing.Errorf("expected float 76.0, got {f}")
    }
}

