module type_casts_0006_test

import "type_casts_0006"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0006.cast_demo(20.3, 21)
    if i != 20 {
        testing.Errorf("expected int 20, got {i}")
    }
    if f != 21.0 {
        testing.Errorf("expected float 21.0, got {f}")
    }
}

