module int_variants_0013

// sum_sizes demonstrates different integer types and sizeof.
pub fn sum_sizes() -> int {
    var s8: int8 = 21
    var s16: int16 = 42
    var s32: int32 = 63
    var s64: int64 = 84
    total := int(s8) + int(s16) + int(s32) + int(s64)
    return total
}

fn main() -> int {
    total := sum_sizes()
    print("Total: {total}")
    return 0
}
