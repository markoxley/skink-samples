module type_casts_0004_test

import "type_casts_0004"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0004.cast_demo(14.1, 59)
    if i != 14 {
        testing.Errorf("expected int 14, got {i}")
    }
    if f != 59.0 {
        testing.Errorf("expected float 59.0, got {f}")
    }
}

