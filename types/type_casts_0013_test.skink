module type_casts_0013_test

import "type_casts_0013"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0013.cast_demo(42.0, 38)
    if i != 42 {
        testing.Errorf("expected int 42, got {i}")
    }
    if f != 38.0 {
        testing.Errorf("expected float 38.0, got {f}")
    }
}

