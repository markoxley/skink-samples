module int_variants_0012

// sum_sizes demonstrates different integer types and sizeof.
pub fn sum_sizes() -> int {
    var s8: uint8 = 190
    var s16: int16 = 380
    var s32: int32 = 570
    var s64: int64 = 760
    total := int(s8) + int(s16) + int(s32) + int(s64)
    return total
}

fn main() -> int {
    total := sum_sizes()
    print("Total: {total}")
    return 0
}
