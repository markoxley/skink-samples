module type_casts_0005_test

import "type_casts_0005"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0005.cast_demo(17.2, 90)
    if i != 17 {
        testing.Errorf("expected int 17, got {i}")
    }
    if f != 90.0 {
        testing.Errorf("expected float 90.0, got {f}")
    }
}

