module type_casts_0001_test

import "type_casts_0001"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0001.cast_demo(4.8, 66)
    if i != 4 {
        testing.Errorf("expected int 4, got {i}")
    }
    if f != 66.0 {
        testing.Errorf("expected float 66.0, got {f}")
    }
}

