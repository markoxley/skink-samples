module type_casts_0003_test

import "type_casts_0003"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0003.cast_demo(11.0, 28)
    if i != 11 {
        testing.Errorf("expected int 11, got {i}")
    }
    if f != 28.0 {
        testing.Errorf("expected float 28.0, got {f}")
    }
}

