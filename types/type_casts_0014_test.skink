module type_casts_0014_test

import "type_casts_0014"
import "testing"

pub fn TestCastDemo() {
    testing.Reset()
    i, f := type_casts_0014.cast_demo(45.1, 69)
    if i != 45 {
        testing.Errorf("expected int 45, got {i}")
    }
    if f != 69.0 {
        testing.Errorf("expected float 69.0, got {f}")
    }
}

