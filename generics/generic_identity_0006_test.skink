module generic_identity_0006_test

import "generic_identity_0006"
import "testing"

pub fn TestDoIdentity() {
    testing.Reset()
    if generic_identity_0006.do_identity(4) != 4 {
        testing.Errorf("identity(4) should return 4")
    }
    if generic_identity_0006.do_identity(0) != 0 {
        testing.Errorf("identity(0) should return 0")
    }
    if generic_identity_0006.do_identity(-1) != -1 {
        testing.Errorf("identity(-1) should return -1")
    }
}

