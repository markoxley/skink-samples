module generic_identity_0008_test

import "generic_identity_0008"
import "testing"

pub fn TestDoIdentity() {
    testing.Reset()
    if generic_identity_0008.do_identity(66) != 66 {
        testing.Errorf("identity(66) should return 66")
    }
    if generic_identity_0008.do_identity(0) != 0 {
        testing.Errorf("identity(0) should return 0")
    }
    if generic_identity_0008.do_identity(-1) != -1 {
        testing.Errorf("identity(-1) should return -1")
    }
}

