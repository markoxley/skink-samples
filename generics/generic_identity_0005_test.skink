module generic_identity_0005_test

import "generic_identity_0005"
import "testing"

pub fn TestDoIdentity() {
    testing.Reset()
    if generic_identity_0005.do_identity(73) != 73 {
        testing.Errorf("identity(73) should return 73")
    }
    if generic_identity_0005.do_identity(0) != 0 {
        testing.Errorf("identity(0) should return 0")
    }
    if generic_identity_0005.do_identity(-1) != -1 {
        testing.Errorf("identity(-1) should return -1")
    }
}

