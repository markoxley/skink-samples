module generic_identity_0001_test

import "generic_identity_0001"
import "testing"

pub fn TestDoIdentity() {
    testing.Reset()
    if generic_identity_0001.do_identity(49) != 49 {
        testing.Errorf("identity(49) should return 49")
    }
    if generic_identity_0001.do_identity(0) != 0 {
        testing.Errorf("identity(0) should return 0")
    }
    if generic_identity_0001.do_identity(-1) != -1 {
        testing.Errorf("identity(-1) should return -1")
    }
}

