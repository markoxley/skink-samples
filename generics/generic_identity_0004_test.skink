module generic_identity_0004_test

import "generic_identity_0004"
import "testing"

pub fn TestDoIdentity() {
    testing.Reset()
    if generic_identity_0004.do_identity(42) != 42 {
        testing.Errorf("identity(42) should return 42")
    }
    if generic_identity_0004.do_identity(0) != 0 {
        testing.Errorf("identity(0) should return 0")
    }
    if generic_identity_0004.do_identity(-1) != -1 {
        testing.Errorf("identity(-1) should return -1")
    }
}

