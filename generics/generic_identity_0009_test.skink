module generic_identity_0009_test

import "generic_identity_0009"
import "testing"

pub fn TestDoIdentity() {
    testing.Reset()
    if generic_identity_0009.do_identity(97) != 97 {
        testing.Errorf("identity(97) should return 97")
    }
    if generic_identity_0009.do_identity(0) != 0 {
        testing.Errorf("identity(0) should return 0")
    }
    if generic_identity_0009.do_identity(-1) != -1 {
        testing.Errorf("identity(-1) should return -1")
    }
}

