module divide_error_0013_test

import "divide_error_0013"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0013.safe_divide(43.0, 44.7)
    if result != 0.9619686800894854 {
        testing.Errorf("expected 0.9619686800894854, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0013.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

