module error_propagation_0012_test

import "error_propagation_0012"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0012.safe_chain(39.9, 41.6, 43.3)
    if result != 0.022150914904956475 {
        testing.Errorf("expected 0.022150914904956475, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0012.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

