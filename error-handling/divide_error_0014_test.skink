module divide_error_0014_test

import "divide_error_0014"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0014.safe_divide(46.1, 47.8)
    if result != 0.9644351464435147 {
        testing.Errorf("expected 0.9644351464435147, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0014.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

