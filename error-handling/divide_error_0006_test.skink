module divide_error_0006_test

import "divide_error_0006"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0006.safe_divide(21.3, 23.0)
    if result != 0.9260869565217391 {
        testing.Errorf("expected 0.9260869565217391, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0006.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

