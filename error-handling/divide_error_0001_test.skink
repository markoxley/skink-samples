module divide_error_0001_test

import "divide_error_0001"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0001.safe_divide(5.8, 7.5)
    if result != 0.7733333333333333 {
        testing.Errorf("expected 0.7733333333333333, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0001.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

