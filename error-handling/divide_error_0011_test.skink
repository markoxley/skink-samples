module divide_error_0011_test

import "divide_error_0011"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0011.safe_divide(36.8, 38.5)
    if result != 0.9558441558441557 {
        testing.Errorf("expected 0.9558441558441557, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0011.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

