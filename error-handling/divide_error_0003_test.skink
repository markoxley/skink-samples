module divide_error_0003_test

import "divide_error_0003"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0003.safe_divide(12.0, 13.7)
    if result != 0.8759124087591241 {
        testing.Errorf("expected 0.8759124087591241, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0003.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

