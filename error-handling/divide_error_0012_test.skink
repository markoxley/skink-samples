module divide_error_0012_test

import "divide_error_0012"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0012.safe_divide(39.9, 41.6)
    if result != 0.9591346153846153 {
        testing.Errorf("expected 0.9591346153846153, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0012.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

