module divide_error_0009_test

import "divide_error_0009"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0009.safe_divide(30.6, 32.3)
    if result != 0.9473684210526317 {
        testing.Errorf("expected 0.9473684210526317, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0009.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

