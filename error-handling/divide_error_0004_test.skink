module divide_error_0004_test

import "divide_error_0004"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0004.safe_divide(15.1, 16.8)
    if result != 0.8988095238095237 {
        testing.Errorf("expected 0.8988095238095237, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0004.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

