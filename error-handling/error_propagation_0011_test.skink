module error_propagation_0011_test

import "error_propagation_0011"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0011.safe_chain(36.8, 38.5, 40.2)
    if result != 0.023777217807068547 {
        testing.Errorf("expected 0.023777217807068547, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0011.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

