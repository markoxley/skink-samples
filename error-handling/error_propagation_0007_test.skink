module error_propagation_0007_test

import "error_propagation_0007"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0007.safe_chain(24.4, 26.1, 27.8)
    if result != 0.03362826979795473 {
        testing.Errorf("expected 0.03362826979795473, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0007.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

