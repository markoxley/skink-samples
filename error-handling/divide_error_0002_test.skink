module divide_error_0002_test

import "divide_error_0002"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0002.safe_divide(8.9, 10.6)
    if result != 0.839622641509434 {
        testing.Errorf("expected 0.839622641509434, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0002.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

