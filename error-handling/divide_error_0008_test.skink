module divide_error_0008_test

import "divide_error_0008"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0008.safe_divide(27.5, 29.2)
    if result != 0.9417808219178082 {
        testing.Errorf("expected 0.9417808219178082, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0008.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

