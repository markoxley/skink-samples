module error_propagation_0003_test

import "error_propagation_0003"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0003.safe_chain(12.0, 13.7, 15.4)
    if result != 0.05687742914020286 {
        testing.Errorf("expected 0.05687742914020286, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0003.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

