module error_propagation_0002_test

import "error_propagation_0002"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0002.safe_chain(8.9, 10.6, 12.3)
    if result != 0.06826200337475073 {
        testing.Errorf("expected 0.06826200337475073, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0002.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

