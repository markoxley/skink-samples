module error_propagation_0015_test

import "error_propagation_0015"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0015.safe_chain(49.2, 50.9, 52.6)
    if result != 0.01837644826581607 {
        testing.Errorf("expected 0.01837644826581607, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0015.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

