module divide_error_0007_test

import "divide_error_0007"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0007.safe_divide(24.4, 26.1)
    if result != 0.9348659003831417 {
        testing.Errorf("expected 0.9348659003831417, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0007.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

