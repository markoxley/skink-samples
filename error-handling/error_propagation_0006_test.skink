module error_propagation_0006_test

import "error_propagation_0006"
import "testing"

pub fn TestSafeChain() {
    testing.Reset()
    result := error_propagation_0006.safe_chain(21.3, 23.0, 24.7)
    if result != 0.037493399049463125 {
        testing.Errorf("expected 0.037493399049463125, got {result}")
    }
    // Division by zero in chain should return -1
    result2 := error_propagation_0006.safe_chain(10.0, 0.0, 2.0)
    if result2 != -1.0 {
        testing.Errorf("chain with zero divisor should return -1, got {result2}")
    }
}

