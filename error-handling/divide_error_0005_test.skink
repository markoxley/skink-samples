module divide_error_0005_test

import "divide_error_0005"
import "testing"

pub fn TestSafeDivide() {
    testing.Reset()
    result := divide_error_0005.safe_divide(18.2, 19.9)
    if result != 0.9145728643216081 {
        testing.Errorf("expected 0.9145728643216081, got {result}")
    }
    // Division by zero should return -1
    result2 := divide_error_0005.safe_divide(10.0, 0.0)
    if result2 != -1.0 {
        testing.Errorf("division by zero should return -1, got {result2}")
    }
}

