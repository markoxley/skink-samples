module if_else_0006

// classify returns a string label for a score.
pub fn classify(score: int) -> string {
    if score >= 90 {
        return "A"
    } else if score >= 80 {
        return "B"
    } else if score >= 70 {
        return "C"
    } else if score >= 60 {
        return "D"
    } else {
        return "F"
    }
}

fn main() -> int {
    grade := classify(3)
    print("Grade: {grade}")
    return 0
}
