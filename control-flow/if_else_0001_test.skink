module if_else_0001_test

import "if_else_0001"
import "testing"

pub fn TestClassify() {
    testing.Reset()
    if if_else_0001.classify(95) != "A" {
        testing.Errorf("95 should be A")
    }
    if if_else_0001.classify(85) != "B" {
        testing.Errorf("85 should be B")
    }
    if if_else_0001.classify(75) != "C" {
        testing.Errorf("75 should be C")
    }
    if if_else_0001.classify(65) != "D" {
        testing.Errorf("65 should be D")
    }
    if if_else_0001.classify(55) != "F" {
        testing.Errorf("55 should be F")
    }
}

