module file_read_write_0010_test

import "file_read_write_0010"
import "testing"

pub fn TestWriteAndRead() {
    testing.Reset()
    result := file_read_write_0010.write_and_read("test_file_read_write_0010.txt", "mango red")
    if result != "mango red" {
        testing.Errorf("expected 'mango red', got '{result}'")
    }
    // Test with different data
    result2 := file_read_write_0010.write_and_read("test_file_read_write_0010.txt_2", "hello world")
    if result2 != "hello world" {
        testing.Errorf("expected 'hello world', got '{result2}'")
    }
}

