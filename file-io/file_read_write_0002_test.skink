module file_read_write_0002_test

import "file_read_write_0002"
import "testing"

pub fn TestWriteAndRead() {
    testing.Reset()
    result := file_read_write_0002.write_and_read("test_file_read_write_0002.txt", "cherry blue")
    if result != "cherry blue" {
        testing.Errorf("expected 'cherry blue', got '{result}'")
    }
    // Test with different data
    result2 := file_read_write_0002.write_and_read("test_file_read_write_0002.txt_2", "hello world")
    if result2 != "hello world" {
        testing.Errorf("expected 'hello world', got '{result2}'")
    }
}

