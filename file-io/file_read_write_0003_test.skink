module file_read_write_0003_test

import "file_read_write_0003"
import "testing"

pub fn TestWriteAndRead() {
    testing.Reset()
    result := file_read_write_0003.write_and_read("test_file_read_write_0003.txt", "date yellow")
    if result != "date yellow" {
        testing.Errorf("expected 'date yellow', got '{result}'")
    }
    // Test with different data
    result2 := file_read_write_0003.write_and_read("test_file_read_write_0003.txt_2", "hello world")
    if result2 != "hello world" {
        testing.Errorf("expected 'hello world', got '{result2}'")
    }
}

