module file_read_write_0009_test

import "file_read_write_0009"
import "testing"

pub fn TestWriteAndRead() {
    testing.Reset()
    result := file_read_write_0009.write_and_read("test_file_read_write_0009.txt", "lemon teal")
    if result != "lemon teal" {
        testing.Errorf("expected 'lemon teal', got '{result}'")
    }
    // Test with different data
    result2 := file_read_write_0009.write_and_read("test_file_read_write_0009.txt_2", "hello world")
    if result2 != "hello world" {
        testing.Errorf("expected 'hello world', got '{result2}'")
    }
}

