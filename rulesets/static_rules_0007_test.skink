module static_rules_0007_test

import "static_rules_0007"
import "testing"

pub fn TestStaticAndDynamicFire() {
    testing.Reset()
    s, d := static_rules_0007.check_mixed(35.0, 60.0)
    if s == 0 {
        testing.Errorf("static high rule should fire at 35.0")
    }
    if d == 0 {
        testing.Errorf("dynamic source should fire when reading > threshold")
    }
}

pub fn TestOnlyStaticFires() {
    testing.Reset()
    s, d := static_rules_0007.check_mixed(35.0, 10.0)
    if s == 0 {
        testing.Errorf("static high rule should fire at 35.0")
    }
    if d > 0 {
        testing.Errorf("dynamic source should not fire when reading < threshold")
    }
}
