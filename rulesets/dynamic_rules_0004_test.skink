module dynamic_rules_0004_test

import "dynamic_rules_0004"
import "testing"

pub fn TestCheckTriggered() {
    testing.Reset()
    if !dynamic_rules_0004.check_triggered(24.1, 29.1) {
        testing.Errorf("should be triggered when reading > threshold")
    }
    if dynamic_rules_0004.check_triggered(100.0, 50.0) {
        testing.Errorf("should not be triggered when reading < threshold")
    }
}

