module dynamic_rules_0008_test

import "dynamic_rules_0008"
import "testing"

pub fn TestCheckTriggered() {
    testing.Reset()
    if !dynamic_rules_0008.check_triggered(36.5, 41.5) {
        testing.Errorf("should be triggered when reading > threshold")
    }
    if dynamic_rules_0008.check_triggered(100.0, 50.0) {
        testing.Errorf("should not be triggered when reading < threshold")
    }
}

