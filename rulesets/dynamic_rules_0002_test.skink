module dynamic_rules_0002_test

import "dynamic_rules_0002"
import "testing"

pub fn TestCheckTriggered() {
    testing.Reset()
    if !dynamic_rules_0002.check_triggered(17.9, 22.9) {
        testing.Errorf("should be triggered when reading > threshold")
    }
    if dynamic_rules_0002.check_triggered(100.0, 50.0) {
        testing.Errorf("should not be triggered when reading < threshold")
    }
}

