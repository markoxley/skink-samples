module dynamic_rules_0003_test

import "dynamic_rules_0003"
import "testing"

pub fn TestCheckTriggered() {
    testing.Reset()
    if !dynamic_rules_0003.check_triggered(21.0, 26.0) {
        testing.Errorf("should be triggered when reading > threshold")
    }
    if dynamic_rules_0003.check_triggered(100.0, 50.0) {
        testing.Errorf("should not be triggered when reading < threshold")
    }
}

