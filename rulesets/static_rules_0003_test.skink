module static_rules_0003_test

import "static_rules_0003"
import "testing"

pub fn TestLifecycle() {
    testing.Reset()
    result := static_rules_0003.test_lifecycle(35.0)
    if result == 0 {
        testing.Errorf("rule should fire during start lifecycle")
    }
}

pub fn TestReset() {
    testing.Reset()
    result := static_rules_0003.test_reset(35.0)
    if result == 0 {
        testing.Errorf("rule should fire after reset and restart")
    }
}
