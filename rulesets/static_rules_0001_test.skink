module static_rules_0001_test

import "static_rules_0001"
import "testing"

pub fn TestCheckHighTriggered() {
    testing.Reset()
    result := static_rules_0001.check_high(35.0)
    if result == 0 {
        testing.Errorf("high rule should have fired when temp > 30")
    }
}

pub fn TestCheckHighNotTriggered() {
    testing.Reset()
    result := static_rules_0001.check_high(25.0)
    if result > 0 {
        testing.Errorf("high rule should not fire when temp <= 30")
    }
}
