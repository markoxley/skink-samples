module time_duration_0014_test

import "time_duration_0014"
import "testing"

pub fn TestSecondsToMs() {
    testing.Reset()
    if time_duration_0014.seconds_to_ms(32) != 32000 {
        testing.Errorf("seconds_to_ms(32) should be 32000")
    }
    if time_duration_0014.seconds_to_ms(1) != 1000 {
        testing.Errorf("seconds_to_ms(1) should be 1000")
    }
    if time_duration_0014.seconds_to_ms(0) != 0 {
        testing.Errorf("seconds_to_ms(0) should be 0")
    }
}

pub fn TestMinutesToSeconds() {
    testing.Reset()
    if time_duration_0014.minutes_to_seconds(1) != 60 {
        testing.Errorf("minutes_to_seconds(1) should be 60")
    }
    if time_duration_0014.minutes_to_seconds(5) != 300 {
        testing.Errorf("minutes_to_seconds(5) should be 300")
    }
}

