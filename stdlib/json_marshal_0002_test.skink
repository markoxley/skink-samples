module json_marshal_0002_test

import "json_marshal_0002"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0002.make_person_json("carol", 39)
    expected := "{\"name\":\"carol\",\"age\":39}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0002.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

