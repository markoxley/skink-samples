module json_marshal_0001_test

import "json_marshal_0001"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0001.make_person_json("bob", 68)
    expected := "{\"name\":\"bob\",\"age\":68}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0001.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

