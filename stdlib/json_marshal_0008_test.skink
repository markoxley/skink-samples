module json_marshal_0008_test

import "json_marshal_0008"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0008.make_person_json("iris", 45)
    expected := "{\"name\":\"iris\",\"age\":45}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0008.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

