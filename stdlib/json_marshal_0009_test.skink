module json_marshal_0009_test

import "json_marshal_0009"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0009.make_person_json("jack", 76)
    expected := "{\"name\":\"jack\",\"age\":76}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0009.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

