module json_marshal_0010_test

import "json_marshal_0010"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0010.make_person_json("karen", 47)
    expected := "{\"name\":\"karen\",\"age\":47}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0010.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

