module json_marshal_0006_test

import "json_marshal_0006"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0006.make_person_json("grace", 43)
    expected := "{\"name\":\"grace\",\"age\":43}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0006.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

