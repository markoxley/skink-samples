module json_marshal_0015_test

import "json_marshal_0015"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0015.make_person_json("paul", 22)
    expected := "{\"name\":\"paul\",\"age\":22}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0015.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

