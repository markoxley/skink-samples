module time_duration_0008_test

import "time_duration_0008"
import "testing"

pub fn TestSecondsToMs() {
    testing.Reset()
    if time_duration_0008.seconds_to_ms(26) != 26000 {
        testing.Errorf("seconds_to_ms(26) should be 26000")
    }
    if time_duration_0008.seconds_to_ms(1) != 1000 {
        testing.Errorf("seconds_to_ms(1) should be 1000")
    }
    if time_duration_0008.seconds_to_ms(0) != 0 {
        testing.Errorf("seconds_to_ms(0) should be 0")
    }
}

pub fn TestMinutesToSeconds() {
    testing.Reset()
    if time_duration_0008.minutes_to_seconds(1) != 60 {
        testing.Errorf("minutes_to_seconds(1) should be 60")
    }
    if time_duration_0008.minutes_to_seconds(5) != 300 {
        testing.Errorf("minutes_to_seconds(5) should be 300")
    }
}

