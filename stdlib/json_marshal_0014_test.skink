module json_marshal_0014_test

import "json_marshal_0014"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0014.make_person_json("oscar", 51)
    expected := "{\"name\":\"oscar\",\"age\":51}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0014.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

