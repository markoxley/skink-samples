module json_marshal_0013_test

import "json_marshal_0013"
import "testing"

pub fn TestMakePersonJSON() {
    testing.Reset()
    result := json_marshal_0013.make_person_json("nora", 20)
    expected := "{\"name\":\"nora\",\"age\":20}"
    if result != expected {
        testing.Errorf("expected '{expected}', got '{result}'")
    }
}

pub fn TestParseName() {
    testing.Reset()
    name := json_marshal_0013.parse_name("{\"name\":\"bob\",\"age\":25}")
    if name != "bob" {
        testing.Errorf("expected 'bob', got '{name}'")
    }
}

