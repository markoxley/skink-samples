module map_ops_0015_test

import "map_ops_0015"
import "testing"

pub fn TestLookupOrZero() {
    testing.Reset()
    if map_ops_0015.build_and_lookup("apple") != 83 {
        testing.Errorf("lookup('apple') should be 83")
    }
    if map_ops_0015.build_and_lookup("nonexistent") != 0 {
        testing.Errorf("lookup('nonexistent') should be 0")
    }
}

