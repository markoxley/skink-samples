module array_ops_0007_test

import "array_ops_0007"
import "testing"

pub fn TestSumArr() {
    testing.Reset()
    if array_ops_0007.sum_arr([]int{1, 2, 3}) != 6 {
        testing.Errorf("sum([1,2,3]) should be 6")
    }
    if array_ops_0007.sum_arr([]int{}) != 0 {
        testing.Errorf("sum([]) should be 0")
    }
    result := array_ops_0007.build_and_sum()
    if result != 182 {
        testing.Errorf("expected 182, got {result}")
    }
}

