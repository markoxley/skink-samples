module map_ops_0008_test

import "map_ops_0008"
import "testing"

pub fn TestLookupOrZero() {
    testing.Reset()
    if map_ops_0008.build_and_lookup("kiwi") != 66 {
        testing.Errorf("lookup('kiwi') should be 66")
    }
    if map_ops_0008.build_and_lookup("nonexistent") != 0 {
        testing.Errorf("lookup('nonexistent') should be 0")
    }
}

