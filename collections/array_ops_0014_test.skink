module array_ops_0014_test

import "array_ops_0014"
import "testing"

pub fn TestSumArr() {
    testing.Reset()
    if array_ops_0014.sum_arr([]int{1, 2, 3}) != 6 {
        testing.Errorf("sum([1,2,3]) should be 6")
    }
    if array_ops_0014.sum_arr([]int{}) != 0 {
        testing.Errorf("sum([]) should be 0")
    }
    result := array_ops_0014.build_and_sum()
    if result != 130 {
        testing.Errorf("expected 130, got {result}")
    }
}

